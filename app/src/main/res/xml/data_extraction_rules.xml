<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Android Keystore keys cannot be restored on another device. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="connect_feed_key_pref.xml" />
        <exclude domain="file" path="datastore/connect_feed.pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="connect_feed_key_pref.xml" />
        <exclude domain="file" path="datastore/connect_feed.pb" />
    </device-transfer>
</data-extraction-rules>